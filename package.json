{
  "name": "mantine-vite-template",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ./scripts/build-pages-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint src/App.tsx src/Router.tsx src/Router.test.tsx src/main.tsx src/theme.ts src/layout/SiteLayout.tsx src/lib/formConfig.ts src/lib/githubPages.ts src/content/churchContent.ts src/pages/*.tsx src/components/HeaderSimple/HeaderSimple.tsx src/components/HeaderSimple/HeaderSimple.test.tsx src/components/FooterSimple/FooterSimple.tsx src/components/FooterSimple/FooterSimple.test.tsx src/components/church/*.tsx src/components/church/*.test.tsx test-utils/*.ts --cache",
    "stylelint": "stylelint \"src/index.css\" \"src/layout/**/*.css\" \"src/components/HeaderSimple/**/*.css\" \"src/components/FooterSimple/**/*.css\" \"src/components/church/**/*.css\" --cache",
    "prettier": "prettier --check \"src/App.tsx\" \"src/Router.tsx\" \"src/Router.test.tsx\" \"src/main.tsx\" \"src/theme.ts\" \"src/layout/SiteLayout.tsx\" \"src/lib/*.ts\" \"src/content/*.ts\" \"src/pages/*.tsx\" \"src/components/HeaderSimple/*.tsx\" \"src/components/FooterSimple/*.tsx\" \"src/components/church/*.tsx\" \"test-utils/*.ts\"",
    "prettier:write": "prettier --write \"src/App.tsx\" \"src/Router.tsx\" \"src/Router.test.tsx\" \"src/main.tsx\" \"src/theme.ts\" \"src/layout/SiteLayout.tsx\" \"src/lib/*.ts\" \"src/content/*.ts\" \"src/pages/*.tsx\" \"src/components/HeaderSimple/*.tsx\" \"src/components/FooterSimple/*.tsx\" \"src/components/church/*.tsx\" \"test-utils/*.ts\"",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "npm run typecheck && npm run prettier && npm run lint && npm run vitest && npm run build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/carousel": "^8.3.13",
    "@mantine/core": "^8.3.13",
    "@mantine/dropzone": "^8.3.13",
    "@mantine/form": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@mantine/notifications": "^8.3.13",
    "@mantinex/dev-icons": "^2.0.0",
    "@mantinex/mantine-logo": "^2.0.0",
    "@tabler/icons-react": "^3.36.1",
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "identity-obj-proxy": "^3.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "prop-types": "^15.8.1",
    "storybook": "^10.2.10",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
