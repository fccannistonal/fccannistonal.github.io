rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberAccess(uid) {
      return get(/databases/$(database)/documents/memberAccess/$(uid)).data;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isApprovedMember() {
      return signedIn() && memberAccess(request.auth.uid).status == 'approved';
    }

    function isAdmin() {
      return isApprovedMember() && memberAccess(request.auth.uid).role == 'admin';
    }

    function validVisibility() {
      return request.resource.data.visibility.keys().hasOnly(['email', 'phone', 'household']) &&
        request.resource.data.visibility.email is bool &&
        request.resource.data.visibility.phone is bool &&
        request.resource.data.visibility.household is bool;
    }

    function validProfileWrite(uid) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'phone',
        'household',
        'interests',
        'optIn',
        'approved',
        'visibility',
        'updatedAt'
      ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.phone is string &&
        request.resource.data.household is string &&
        request.resource.data.interests is string &&
        request.resource.data.optIn is bool &&
        request.resource.data.approved == false &&
        validVisibility();
    }

    function validAccessAdminUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt'
      ]) &&
        request.resource.data.status in ['pending', 'approved', 'revoked'];
    }

    function validAdminProfileModeration() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'approved',
        'updatedAt'
      ]) &&
        request.resource.data.approved is bool;
    }

    function validAuditWrite() {
      return request.resource.data.keys().hasOnly(['actorUid', 'action', 'targetUid', 'createdAt']) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.targetUid is string &&
        (
          (
            request.resource.data.targetUid == request.auth.uid &&
            request.resource.data.action in ['access-requested', 'profile-updated']
          ) ||
          (
            isAdmin() &&
            request.resource.data.action in ['access-approved', 'access-revoked']
          )
        );
    }

    match /memberAccess/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'status',
          'requestedAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.role == 'member' &&
        request.resource.data.status == 'pending';

      allow update: if (isAdmin() && validAccessAdminUpdate()) ||
        (
          isSelf(uid) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.role == 'member'
        );

      allow delete: if false;
    }

    match /directoryProfiles/{uid} {
      allow read: if isSelf(uid) ||
        isAdmin() ||
        (
          isApprovedMember() &&
          resource.data.optIn == true &&
          resource.data.approved == true
        );

      allow create: if isSelf(uid) && validProfileWrite(uid);

      allow update: if (isAdmin() && validAdminProfileModeration()) ||
        (isSelf(uid) && validProfileWrite(uid));

      allow delete: if false;
    }

    match /directoryAudit/{auditId} {
      allow read: if isAdmin();

      allow create: if signedIn() && validAuditWrite();

      allow update, delete: if false;
    }

    match /taxDocuments/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
